						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"username\": \"different_user\",\n  \"email\": \"alice_v1@example.com\",\n  \"password\": \"password123\"\n}"
