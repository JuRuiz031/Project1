		{
			"name": "4. Get User by ID - Success (Own User)",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "http://localhost:8080/api/v1/users/{{user_id}}",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8080",
					"path": [
						"api",
						"v1",
						"users",
						"{{user_id}}"
					]
				}
			},
			"response": []
		},
