{
	"info": {
		"_postman_id": "d1e2f3a4-b5c6-7d8e-9f0a-1b2c3d4e5f6a",
		"name": "Calendario API v1 - Login",
		"description": "Login endpoints with JWT token capture for authentication testing",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Login - Success",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"if (pm.response.code === 200) {",
							"    const responseData = pm.response.json();",
							"    pm.environment.set('jwt_token', responseData.token);",
							"    pm.environment.set('token_expires_at', responseData.expires_at);",
							"    pm.environment.set('user_id', responseData.user.user_id);",
							"    console.log('JWT Token captured: ' + responseData.token.substring(0, 20) + '...');",
							"    console.log('Token expires at: ' + responseData.expires_at);",
							"    console.log('User ID: ' + responseData.user.user_id);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"username\": \"alice_v1\",\n  \"password\": \"password123\"\n}"
				},
				"url": {
					"raw": "http://localhost:8080/api/v1/login",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8080",
					"path": [
						"api",
						"v1",
						"login"
					]
				}
			},
			"response": []
		},
