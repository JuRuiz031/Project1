    {
      "name": "10. Generate Invite Link - Success",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    const responseData = pm.response.json();",
              "    const inviteLink = responseData.invite_link;",
              "    // Extract token from invite link",
              "    const token = inviteLink.split('/').pop();",
              "    pm.environment.set('invite_token', token);",
              "    console.log('Invite link generated: ' + inviteLink);",
              "    console.log('Invite token: ' + token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:8080/api/v1/calendars/{{calendar_id}}/invite",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "v1",
            "calendars",
            "{{calendar_id}}",
            "invite"
          ]
        }
      },
      "response": []
    },
